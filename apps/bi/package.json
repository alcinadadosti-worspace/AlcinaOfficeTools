    "@codemirror/view": "6.43.14",
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.344",
    "@lezer/highlight": "1.2.5",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "echarts": "6.1.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "fflate": "0.8.3",
    "immer": "11.1.21",
    "papaparse": "5.7.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
