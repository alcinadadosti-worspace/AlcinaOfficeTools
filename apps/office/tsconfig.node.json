    "src/docs/preload/index.ts",
    "src/point/preload/index.ts",
    "src/notes/preload/index.ts",
    "src/bi/preload/index.ts",
    "../../packages/updater/src/main.ts",
    "../../packages/updater/src/ipc.ts",
