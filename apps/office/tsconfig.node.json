{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@alcina/updater/main": ["../../packages/updater/src/main.ts"],
      "@alcina/updater": ["../../packages/updater/src/index.ts"],
      "@alcina/editor/docmodel": ["../../packages/editor/src/docmodel.ts"],
